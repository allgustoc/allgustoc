# Copie para .env e ajuste. Todas as variáveis são opcionais.

# --- Fontes de dados (separe por vírgula) ---
# serpapi     dinheiro via Google Flights (requer SERPAPI_KEY)
# seats_aero  milhas Smiles/Azul e outros via seats.aero (requer SEATS_AERO_KEY, plano Pro)
# smiles      site da Smiles (navegador automatizado)
# latam       site da LATAM: dinheiro + LATAM Pass (navegador automatizado)
# azul        site da Azul: dinheiro + Azul Fidelidade (navegador automatizado, experimental)
RADAR_PROVIDERS=latam,smiles,azul

SERPAPI_KEY=
SEATS_AERO_KEY=
# Ex.: smiles,azul (vazio = todos os programas)
SEATS_AERO_SOURCES=

# --- Agenda ---
# Um ou mais horários por dia, ex.: 07:00 ou 07:00,19:00
RADAR_RUN_AT=07:00
RADAR_TIMEZONE=America/Sao_Paulo

# --- Ritmo das buscas ---
# Máximo de consultas por fonte em cada varredura (protege contra bloqueio)
RADAR_MAX_SEARCHES_PER_PROVIDER=120
# Pausa média entre consultas, em segundos (multiplicada por fonte; sites usam 1,5x)
RADAR_REQUEST_DELAY=4
# Não repete uma consulta feita há menos de N horas (por qualquer radar)
RADAR_REFRESH_HOURS=20
# Tarifas mais antigas que N dias são descartadas
RADAR_STALE_DAYS=4
# Datas fora da janela são amostradas a cada N dias, em rodízio
RADAR_EXPLORE_STEP_DAYS=3

# --- Avaliação ---
# Seu custo do milheiro (R$ por 1.000 milhas). Use o quanto você paga/venderia.
RADAR_MILHEIRO=smiles=16,latampass=25,azul=15
# Cotações para converter taxas cobradas em outra moeda
RADAR_FX=USD=5.40,EUR=6.30
# Taxa de embarque estimada (R$ por trecho) quando a fonte não informa
RADAR_TAX_ESTIMATE_BRL=450
# Sugere datas fora da janela se ficarem pelo menos 12% mais baratas
RADAR_SUGGESTION_MIN_SAVING=0.12
# "Promoção" = 10% abaixo da média recente do radar
RADAR_DEAL_THRESHOLD=0.10
# true se você é assinante do Clube Smiles (libera a tarifa de clube)
RADAR_SMILES_CLUB=false

# --- Navegador (fontes smiles, latam, azul) ---
# false = janela visível (você acompanha o que o bot faz); true = invisível (servidor/Docker)
RADAR_BROWSER_HEADLESS=false
RADAR_BROWSER_PROFILE_DIR=data/browser
# Caminho de um Chromium já instalado (opcional)
RADAR_BROWSER_EXECUTABLE=
RADAR_BROWSER_TIMEOUT=45
# Salva as respostas brutas dos sites aqui (útil para depurar conectores)
RADAR_DEBUG_DUMP_DIR=

# --- Notificações ---
# digest = resumo diário sempre; deals = só quando houver oportunidade
RADAR_NOTIFY=digest
# WhatsApp para o seu número via CallMeBot (veja o README)
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

RADAR_DB_PATH=data/radar.db
